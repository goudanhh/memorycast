# ---------- Required ----------
POSTGRES_DB=memorycast
POSTGRES_USER=memorycast
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS

# Public URL:
# First deployment by IP:
# PUBLIC_URL=http://YOUR_ORACLE_PUBLIC_IP
# Domain deployment:
PUBLIC_URL=http://YOUR_ORACLE_PUBLIC_IP

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- AI (optional, but required for AI organize / quiz grading) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# FSRS desired retention, 0.90 = 90%
FSRS_RETENTION=0.90
