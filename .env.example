# ---------- Required ----------
POSTGRES_DB=memorycast
POSTGRES_USER=memorycast
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
# ---------- AI (optional, but required for AI organize / quiz grading) ----------
# Default: Gemini free tier
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional OpenAI fallback:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# FSRS desired retention, 0.90 = 90%
FSRS_RETENTION=0.90
