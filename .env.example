# ---------- Required ----------
POSTGRES_DB=memorycast
POSTGRES_USER=memorycast
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
# ---------- AI (optional, but required for AI organize / quiz grading) ----------
# Default: Gemini free tier
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional OpenAI fallback:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# FSRS desired retention, 0.90 = 90%
FSRS_RETENTION=0.90


# ---------- TTS (optional; browser TTS is used if not configured) ----------
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westus2

# Realtime Feynman two-stage reasoning
# Gemini defaults: fast=gemini-3.5-flash-lite, deep=gemini-3.8-flash
FEYNMAN_FAST_MODEL=
FEYNMAN_DEEP_MODEL=
