# ---------- Required ----------
POSTGRES_DB=memorycast
POSTGRES_USER=memorycast
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
# ---------- AI (optional, but required for AI organize / quiz grading) ----------
# Default: Gemini free tier
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional OpenAI fallback:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# FSRS desired retention, 0.90 = 90%
FSRS_RETENTION=0.90


# ---------- TTS (optional; browser TTS is used if not configured) ----------
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_MULTILINGUAL_VOICE=en-US-AvaMultilingualNeural
AZURE_EN_MULTILINGUAL_VOICE=en-US-AvaMultilingualNeural
AZURE_ZH_MULTILINGUAL_VOICE=zh-CN-YunxiaoMultilingualNeural
AZURE_EN_NATIVE_VOICE=en-US-AvaNeural
AZURE_ZH_NATIVE_VOICE=zh-CN-XiaoxiaoNeural

# Realtime Feynman two-stage reasoning
# Gemini defaults: fast=gemini-3.5-flash-lite, deep=gemini-3.8-flash
FEYNMAN_FAST_MODEL=
FEYNMAN_DEEP_MODEL=



# ---------- Voice notes / photo OCR ----------
# STT fallback order: Cloudflare -> Gemini -> OpenRouter

# Cloudflare Workers AI
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_MODEL=@cf/google/gemma-4-26b-a4b-it
CLOUDFLARE_STT_MODEL=@cf/openai/whisper-large-v3-turbo
CLOUDFLARE_OCR_MODEL=@cf/moondream/moondream3.1-9B-A2B

# Gemini transcription (reuses GEMINI_API_KEY)
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# OpenRouter transcription
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=openrouter/free
OPENROUTER_STT_MODEL=openai/whisper-large-v3

# Photo OCR: Gemini free-tier multimodal first, Cloudflare Moondream fallback
OCR_MODEL=gemini-3.5-flash-lite
